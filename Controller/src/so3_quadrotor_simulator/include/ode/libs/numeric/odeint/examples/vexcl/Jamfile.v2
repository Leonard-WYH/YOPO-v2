import boost ;
import os ;

boost.use-project ;


# Optional external-library paths are provided by the caller.
VEXCL_INCLUDE = [ os.environ VEXCL_INCLUDE ] ;
CUDA_ROOT = [ os.environ CUDA_HOME ] ;
CUDA_INCLUDE = $(CUDA_ROOT)/include ;


lib opencl : : <name>OpenCL ;

project : requirements
        <library>/boost//headers
        <include>../../../../..
        <include>$(VEXCL_INCLUDE)
        <include>$(CUDA_INCLUDE)
        <toolset>gcc:<cxxflags>-std=c++0x
        ;

exe lorenz_ensemble : lorenz_ensemble.cpp opencl ;
